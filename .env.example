# Copy to .env
DATABASE_URL="file:./dev.db"

# Auth.js session encryption key. Generate with: openssl rand -base64 33
AUTH_SECRET=""

# Show the clickable demo-accounts list on the login page (set to "false" to hide)
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="true"

# Portal addresses (host[:port] as typed in the browser). Each state has its own
# portal; only the admin portal sees all states. In production, e.g.
# PORTAL_HOST_RJ="rajasthan.cmo-monitor.in"
PORTAL_HOST_RJ="rj.localhost:3000"
PORTAL_HOST_MH="mh.localhost:3000"
PORTAL_HOST_ADMIN="admin.localhost:3000"
